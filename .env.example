# ContentFlow — environment variables
# Copy this file to .env.local and fill in the values you need.
# Все переменные опциональны: без них проект работает в демо-режиме.

# --- Supabase (optional, для продакшн-хранения карточек) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI провайдер ---
# Управляется через UI (Настройки → AI провайдер). ENV — серверные дефолты.
# Варианты: openai | ollama | lmstudio
AI_PROVIDER=openai

# OpenAI (cloud)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Ollama (локальная LLM, https://ollama.com)
#   ollama serve
#   ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# LM Studio (локальная LLM, https://lmstudio.ai)
#   LM Studio → Developer → Start Server
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=local-model

# --- N8N webhook (optional, для авто-публикации) ---
# URL вебхука n8n (Prod или Test). Если не задан — /api/publish вернёт demo envelope.
N8N_WEBHOOK_URL=
# (опц.) shared secret, прилетит в заголовок X-ContentFlow-Secret
N8N_WEBHOOK_SECRET=
# (опц.) публичный URL приложения для ссылок в payload
NEXT_PUBLIC_APP_URL=http://localhost:3000
