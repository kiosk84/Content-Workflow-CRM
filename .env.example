# ContentFlow — environment variables
# Copy this file to .env.local and fill in the values you need.

# --- Supabase (optional, для продакшн-хранения карточек) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenAI (optional, для живого AI чата; без него работает демо-режим) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
