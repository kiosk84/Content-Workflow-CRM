# ContentFlow — environment variables
# Copy this file to .env.local and fill in the values you need.

# --- Supabase (optional, для продакшн-хранения карточек) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- OpenAI (optional, для живого AI чата; без него работает демо-режим) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- N8N webhook (optional, для авто-публикации) ---
# URL вебхука n8n (Prod или Test). Если не задан — сервер возвращает demo-режим.
N8N_WEBHOOK_URL=
# (опционально) shared secret, прилетит в заголовок X-ContentFlow-Secret
N8N_WEBHOOK_SECRET=
# (опционально) дефолтный URL на карточку — используется в payload как card_url
NEXT_PUBLIC_APP_URL=http://localhost:3000
